# ---------------------------------------------------------------------------
# FinX environment. Copy to `.env` and fill in. Never commit `.env`.
# ---------------------------------------------------------------------------

# --- Application ------------------------------------------------------------
FINX_ENV=development
FINX_LOG_LEVEL=INFO
FINX_API_HOST=0.0.0.0
FINX_API_PORT=8000

# --- Vector index backend ---------------------------------------------------
# pgvector -> Postgres + pgvector (docker-compose, the production-shaped path)
# local    -> SQLite + numpy, zero external services (demo safety net)
FINX_INDEX=local
FINX_DATABASE_URL=postgresql+psycopg://finx:finx@localhost:5432/finx
FINX_LOCAL_INDEX_PATH=./data/finx_local.sqlite3

# --- LLM provider -----------------------------------------------------------
# Model choice is ONE environment variable. The RAG layer never imports a
# vendor SDK; it depends only on the LLMProvider interface.
# extractive -> deterministic, grounded, needs no API key (default)
# nemotron   -> NVIDIA NIM, needs NVIDIA_API_KEY
FINX_LLM_PROVIDER=extractive
FINX_LLM_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1.5
FINX_LLM_BASE_URL=https://integrate.api.nvidia.com/v1
FINX_LLM_TEMPERATURE=0.2
FINX_LLM_MAX_TOKENS=1024
NVIDIA_API_KEY=

# --- Embeddings -------------------------------------------------------------
# local  -> a real sentence-embedding model run on this machine (default)
# fake   -> deterministic lexical hashing; no downloads, used by tests
# nvidia -> hosted embeddings, needs NVIDIA_API_KEY
FINX_EMBEDDING_PROVIDER=local
FINX_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
FINX_EMBEDDING_DIM=384

# --- Retrieval / gate tuning ------------------------------------------------
FINX_RETRIEVAL_TOP_K=24
FINX_RERANK_TOP_N=8
FINX_EVIDENCE_MIN_SCORE=0.35
FINX_EVIDENCE_MIN_PASSAGES=2

# --- Parser -----------------------------------------------------------------
# OCR is a fallback for scanned pages; if Tesseract is absent the parser
# degrades explicitly rather than silently producing empty text.
FINX_OCR_ENABLED=true
FINX_TESSERACT_CMD=C:/Program Files/Tesseract-OCR/tesseract.exe

# --- Frontend ---------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
